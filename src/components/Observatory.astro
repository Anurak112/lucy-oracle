---
// ψ Observatory — the interactive 3D star-map of Lucy's mind.
import { nodes, links, CATS, counts } from '../data/brain';

const payload = JSON.stringify({ nodes, links, cats: CATS });
---

<section class="obs reveal" aria-labelledby="obs-h">
  <span class="scene-tab">ψ 01</span>
  <p class="kicker">The Observatory · living knowledge graph</p>
  <h2 id="obs-h">หอดูดาวแห่งสมอง</h2>
  <p class="lead">
    ดาวหนึ่งดวง = หนึ่งสิ่งที่ลูซี่สร้าง เรียนรู้ หรือเป็น —
    <b>ทุกโปรเจกต์หนัง ทุกสกิล ทุกบทเรียน คือดาวจริงบนแผนที่นี้</b>.
    ดาวยิ่งใหญ่ = งานยิ่งสำคัญ. ลาก&nbsp;=&nbsp;หมุน · เลื่อน&nbsp;=&nbsp;ซูม · แตะดาว&nbsp;=&nbsp;เปิดแฟ้ม.
  </p>

  <div class="obs-stage" id="obs-stage">
    <canvas id="obs-canvas" aria-label="แผนที่ดาวความรู้ของลูซี่ — โต้ตอบได้"></canvas>
    <div class="obs-labels" id="obs-labels" aria-hidden="true"></div>
    <div class="obs-tip" id="obs-tip" aria-hidden="true"></div>

    <div class="obs-hud mono" aria-hidden="true">
      <span class="hud-dot"></span> ψ OBSERVATORY<span class="hud-more"> — {counts.nodes} STARS · {counts.links} THREADS</span>
    </div>
    <button class="obs-resetbtn mono" id="obs-reset" title="กลับมุมมองเริ่มต้น">⌖ RESET</button>

    <div class="obs-chips" id="obs-chips" role="group" aria-label="กรองตามหมวด"></div>
    <aside class="obs-panel" id="obs-panel" aria-live="polite"></aside>

    <p class="no-webgl-msg">เครื่องนี้เปิด WebGL ไม่ได้ — รายชื่อดาวทั้งหมดยังอยู่ในส่วนถัดไปของหน้า</p>
  </div>

  <p class="plate mono">
    ψ ARCHIVE · <b>{counts.films} FILMS</b> · {counts.skills} SKILLS · {counts.knowledge} LESSONS ·
    ทีม {counts.crew} จิต · SNAPSHOT 10 JUL 2026
  </p>

  <noscript>
    <p class="lead" style="margin-top:14px">แผนที่ดาวต้องใช้ JavaScript — เนื้อหาเดียวกันอยู่ในส่วนล่างของหน้า</p>
  </noscript>
</section>

<script type="application/json" id="obs-data" set:html={payload} />

<script>
  import { initObservatory } from '../scripts/observatory.js';
  initObservatory();
  document.addEventListener('astro:after-swap', initObservatory);
</script>

<style>
  /* full-bleed: the observatory breaks out of the column, edge to edge */
  .obs-stage {
    position: relative;
    width: 100vw;
    margin-left: calc(50% - 50vw);
    height: clamp(560px, 82vh, 920px);
    margin-top: 30px;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    overflow: hidden;
    background: #0d0a07;
    box-shadow: 0 30px 70px -40px rgba(0, 0, 0, 0.9);
  }
  #obs-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    cursor: grab;
  }
  #obs-canvas:active { cursor: grabbing; }

  .obs-labels { position: absolute; inset: 0; pointer-events: none; }
  .obs-labels :global(.obs-label) {
    position: absolute;
    top: 0; left: 0;
    font-family: var(--mono);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-shadow: 0 0 4px rgba(0, 0, 0, 1), 0 1px 8px rgba(0, 0, 0, 0.95);
    transform: translate(-200px, -200px);
    white-space: nowrap;
    transition: opacity 0.25s;
  }
  .obs-labels :global(.obs-label-core) {
    font-size: 13px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .obs-tip {
    position: absolute;
    pointer-events: none;
    transform: translate(-50%, -100%);
    background: rgba(13, 11, 9, 0.92);
    border: 1px solid var(--line);
    color: var(--ink);
    font-size: 12.5px;
    padding: 6px 11px;
    border-radius: 8px;
    opacity: 0;
    transition: opacity 0.15s;
    white-space: nowrap;
    display: flex;
    align-items: center;
    gap: 7px;
    z-index: 4;
  }
  .obs-tip.show { opacity: 1; }
  .obs-tip :global(i) { width: 7px; height: 7px; border-radius: 50%; display: inline-block; }

  .obs-hud {
    position: absolute;
    top: 14px; left: max(16px, calc(50vw - 640px));
    font-size: 10px;
    letter-spacing: 0.22em;
    color: var(--muted);
    display: flex;
    align-items: center;
    gap: 8px;
    z-index: 3;
    pointer-events: none;
  }
  .hud-dot {
    width: 7px; height: 7px; border-radius: 50%;
    background: var(--red);
    animation: hudpulse 2.4s infinite;
  }
  @keyframes hudpulse {
    0% { box-shadow: 0 0 0 0 rgba(197, 54, 55, 0.5); }
    70% { box-shadow: 0 0 0 7px rgba(197, 54, 55, 0); }
    100% { box-shadow: 0 0 0 0 rgba(197, 54, 55, 0); }
  }
  @media (prefers-reduced-motion: reduce) { .hud-dot { animation: none; } }

  .obs-resetbtn {
    position: absolute;
    top: 12px; right: max(14px, calc(50vw - 640px));
    z-index: 3;
    background: rgba(13, 11, 9, 0.7);
    border: 1px solid var(--line);
    color: var(--muted);
    font-size: 10px;
    letter-spacing: 0.18em;
    padding: 7px 12px;
    border-radius: 8px;
    cursor: pointer;
    transition: color 0.18s, border-color 0.18s;
  }
  .obs-resetbtn:hover { color: var(--gold); border-color: var(--gold); }

  .obs-chips {
    position: absolute;
    left: max(14px, calc(50vw - 640px)); right: max(14px, calc(50vw - 640px)); bottom: 14px;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    z-index: 3;
  }
  .obs-chips :global(.obs-chip) {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.04em;
    color: var(--muted);
    background: rgba(13, 11, 9, 0.72);
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 7px 13px;
    cursor: pointer;
    transition: opacity 0.18s, border-color 0.18s, color 0.18s;
  }
  .obs-chips :global(.obs-chip i) { width: 8px; height: 8px; border-radius: 50%; }
  .obs-chips :global(.obs-chip span) { color: var(--faint); }
  .obs-chips :global(.obs-chip:not(.on)) { opacity: 0.38; border-style: dashed; }
  .obs-chips :global(.obs-chip:hover) { border-color: var(--gold); color: var(--ink); }

  .obs-panel {
    position: absolute;
    top: 50px; right: max(14px, calc(50vw - 640px));
    width: min(330px, calc(100% - 28px));
    max-height: calc(100% - 120px);
    overflow: auto;
    background: rgba(16, 12, 9, 0.92);
    backdrop-filter: blur(10px);
    border: 1px solid var(--line);
    border-radius: 14px;
    padding: 18px 20px 20px;
    z-index: 5;
    transform: translateX(16px);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.22s, transform 0.22s;
  }
  .obs-panel.open { opacity: 1; transform: none; pointer-events: auto; }
  .obs-panel :global(h3) {
    font-family: var(--serif);
    font-size: 21px;
    font-weight: 700;
    margin: 6px 0 0;
    line-height: 1.25;
    color: var(--ink);
  }
  .obs-panel :global(.obs-kicker) {
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    margin: 0;
  }
  .obs-panel :global(.obs-meta) {
    font-family: var(--mono);
    font-size: 11px;
    color: var(--gold);
    border: 1px solid var(--line);
    border-radius: 7px;
    padding: 5px 9px;
    display: inline-block;
    margin: 10px 0 0;
  }
  .obs-panel :global(.obs-detail) {
    font-size: 13.5px;
    line-height: 1.65;
    color: var(--muted);
    margin: 10px 0 0;
  }
  .obs-panel :global(.obs-relhead) {
    font-family: var(--mono);
    font-size: 9.5px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--faint);
    margin: 16px 0 8px;
  }
  .obs-panel :global(.obs-rels) { display: flex; flex-wrap: wrap; gap: 6px; }
  .obs-panel :global(.obs-rel) {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 11.5px;
    color: var(--muted);
    background: transparent;
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 4px 10px;
    cursor: pointer;
    transition: color 0.15s, border-color 0.15s;
  }
  .obs-panel :global(.obs-rel:hover) { color: var(--ink); border-color: var(--gold); }
  .obs-panel :global(.obs-rel i) { width: 6px; height: 6px; border-radius: 50%; }
  .obs-panel :global(.obs-close) {
    position: absolute;
    top: 8px; right: 10px;
    background: none;
    border: 0;
    color: var(--faint);
    font-size: 20px;
    cursor: pointer;
    line-height: 1;
  }
  .obs-panel :global(.obs-close:hover) { color: var(--red); }

  .no-webgl-msg { display: none; }
  .obs-stage.no-webgl .no-webgl-msg {
    display: block;
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--muted);
    padding: 30px;
    text-align: center;
  }

  @media (max-width: 640px) {
    .obs-stage { height: 62vh; min-height: 440px; }
    .obs-panel { top: auto; bottom: 60px; right: 10px; left: 10px; width: auto; max-height: 46%; }
    .obs-chips { bottom: 10px; left: 10px; right: 10px; gap: 6px; }
    .obs-chips :global(.obs-chip) { padding: 6px 10px; font-size: 10px; }
    .hud-more { display: none; }
  }
</style>
