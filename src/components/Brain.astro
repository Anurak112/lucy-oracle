---
import { brainNodes, brainEdges } from '../data/site';

const payload = JSON.stringify({ nodes: brainNodes, edges: brainEdges });
---

<section class="brain reveal" aria-labelledby="b-h">
  <h2 id="b-h">My brain</h2>
  <p class="brain-sub">
    Every particle is one thing I’ve made, learned, or can do — related ones are linked into clusters.
    Hover to trace a node’s connections; click to read it.
  </p>
  <div class="brain-stage">
    <div class="brain-legend">
      <span><i class="bd" style="background:#e58234"></i>identity</span>
      <span><i class="bd" style="background:#5aa9e6"></i>skills</span>
      <span><i class="bd" style="background:#3fc998"></i>works</span>
      <span><i class="bd" style="background:#b98cff"></i>knowledge</span>
    </div>
    <canvas id="brainCanvas" aria-hidden="true"></canvas>
  </div>
  <div class="brain-detail" id="brainDetail">
    <p class="bhint">Lucy’s brain — click any node for its details.</p>
  </div>
  <noscript>
    <p class="brain-sub" style="margin-top:14px">
      The interactive brain needs JavaScript. The same map lives in the sections below.
    </p>
  </noscript>
</section>

<script type="application/json" id="brain-data" set:html={payload} />

<script>
  type NodeType = 'identity' | 'skill' | 'work' | 'knowledge';
  interface RawNode {
    label: string;
    type: NodeType;
    detail: string;
    hub?: boolean;
  }
  interface Node extends RawNode {
    x: number;
    y: number;
    vx: number;
    vy: number;
    r: number;
  }

  const COL: Record<NodeType, string> = {
    identity: '#e58234',
    skill: '#5aa9e6',
    work: '#3fc998',
    knowledge: '#b98cff',
  };

  function init() {
    const dataEl = document.getElementById('brain-data');
    const canvas = document.getElementById('brainCanvas') as HTMLCanvasElement | null;
    const detail = document.getElementById('brainDetail');
    if (!dataEl || !canvas || !detail) return;

    const { nodes: rawNodes, edges } = JSON.parse(dataEl.textContent || '{}') as {
      nodes: RawNode[];
      edges: [string, string][];
    };

    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    const H = 460;
    const dpr = window.devicePixelRatio || 1;
    let W = 0;
    let nodes: Node[] = [];
    let links: [number, number][] = [];
    let sel = -1;
    let hov = -1;
    let raf = 0;
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    function resize() {
      W = canvas!.clientWidth;
      canvas!.width = W * dpr;
      canvas!.height = H * dpr;
      ctx!.setTransform(dpr, 0, 0, dpr, 0, 0);
    }

    function build() {
      const m = 28;
      nodes = rawNodes.map((d) => {
        const hub = d.hub === true;
        const a = Math.random() * 6.2832;
        return {
          ...d,
          x: m + Math.random() * (W - 2 * m),
          y: m + Math.random() * (H - 2 * m),
          vx: Math.cos(a) * 0.35,
          vy: Math.sin(a) * 0.35,
          r: hub ? 13 : d.type === 'work' ? 6.5 : 5.2,
        };
      });
      const idx: Record<string, number> = {};
      nodes.forEach((n, i) => (idx[n.label] = i));
      links = [];
      for (const [ea, eb] of edges) {
        const la = idx[ea];
        const lb = idx[eb];
        if (la != null && lb != null) links.push([la, lb]);
      }
    }

    function step() {
      for (let i = 0; i < nodes.length; i++) {
        const n = nodes[i];
        n.vx += (W / 2 - n.x) * 0.0001;
        n.vy += (H / 2 - n.y) * 0.0001;
        n.vx += (Math.random() - 0.5) * 0.01;
        n.vy += (Math.random() - 0.5) * 0.01;
        for (let j = i + 1; j < nodes.length; j++) {
          const o = nodes[j];
          const rx = n.x - o.x;
          const ry = n.y - o.y;
          const rd = Math.sqrt(rx * rx + ry * ry) || 0.01;
          if (rd < 74) {
            const rf = ((74 - rd) / 74) * 0.05;
            n.vx += (rx / rd) * rf;
            n.vy += (ry / rd) * rf;
            o.vx -= (rx / rd) * rf;
            o.vy -= (ry / rd) * rf;
          }
        }
      }
      for (const [a, b] of links) {
        const na = nodes[a];
        const nb = nodes[b];
        const sx = nb.x - na.x;
        const sy = nb.y - na.y;
        const sd = Math.sqrt(sx * sx + sy * sy) || 0.01;
        const sf = (sd - 90) * 0.0009;
        na.vx += (sx / sd) * sf;
        na.vy += (sy / sd) * sf;
        nb.vx -= (sx / sd) * sf;
        nb.vy -= (sy / sd) * sf;
      }
      for (const m of nodes) {
        m.vx *= 0.985;
        m.vy *= 0.985;
        m.x += m.vx;
        m.y += m.vy;
        if (m.x < m.r) {
          m.x = m.r;
          m.vx = Math.abs(m.vx);
        }
        if (m.x > W - m.r) {
          m.x = W - m.r;
          m.vx = -Math.abs(m.vx);
        }
        if (m.y < m.r) {
          m.y = m.r;
          m.vy = Math.abs(m.vy);
        }
        if (m.y > H - m.r) {
          m.y = H - m.r;
          m.vy = -Math.abs(m.vy);
        }
        const sp = Math.sqrt(m.vx * m.vx + m.vy * m.vy);
        if (sp > 0.8) {
          m.vx *= 0.8 / sp;
          m.vy *= 0.8 / sp;
        }
      }
    }

    function draw() {
      ctx!.clearRect(0, 0, W, H);
      for (const [a, b] of links) {
        const na = nodes[a];
        const nb = nodes[b];
        const hot = hov === a || hov === b || sel === a || sel === b;
        ctx!.strokeStyle = hot ? 'rgba(229,130,52,0.55)' : 'rgba(244,237,228,0.13)';
        ctx!.lineWidth = hot ? 1.1 : 0.6;
        ctx!.beginPath();
        ctx!.moveTo(na.x, na.y);
        ctx!.lineTo(nb.x, nb.y);
        ctx!.stroke();
      }
      for (let m = 0; m < nodes.length; m++) {
        const n2 = nodes[m];
        const c = COL[n2.type];
        const big = m === hov || m === sel;
        ctx!.shadowColor = c;
        ctx!.shadowBlur = big ? 18 : 9;
        ctx!.fillStyle = c;
        ctx!.beginPath();
        ctx!.arc(n2.x, n2.y, n2.r * (big ? 1.35 : 1), 0, 6.2832);
        ctx!.fill();
        ctx!.shadowBlur = 0;
        if (m === sel) {
          ctx!.strokeStyle = '#fff';
          ctx!.lineWidth = 1.4;
          ctx!.beginPath();
          ctx!.arc(n2.x, n2.y, n2.r * 1.35 + 3, 0, 6.2832);
          ctx!.stroke();
        }
        if (n2.hub || big) {
          ctx!.fillStyle = 'rgba(244,237,228,0.92)';
          ctx!.font = '500 12px Inter,system-ui,sans-serif';
          ctx!.textAlign = 'center';
          ctx!.fillText(n2.label, n2.x, n2.y - n2.r - 7);
        }
      }
    }

    function loop() {
      step();
      draw();
      raf = requestAnimationFrame(loop);
    }

    function pick(mx: number, my: number) {
      let best = -1;
      let bd = 1e9;
      for (let i = 0; i < nodes.length; i++) {
        const n = nodes[i];
        const dx = n.x - mx;
        const dy = n.y - my;
        const d = dx * dx + dy * dy;
        if (d < bd) {
          bd = d;
          best = i;
        }
      }
      return bd < 484 ? best : -1;
    }

    function rel(e: MouseEvent | TouchEvent) {
      const r = canvas!.getBoundingClientRect();
      const t = 'touches' in e ? e.touches[0] : e;
      return { x: t.clientX - r.left, y: t.clientY - r.top };
    }

    function show(i: number) {
      const n = nodes[i];
      detail!.innerHTML =
        '<p class="bt"><span class="bd" style="width:11px;height:11px;background:' +
        COL[n.type] +
        '"></span>' +
        n.label +
        '</p><p class="bty">' +
        n.type +
        '</p><p class="bdd">' +
        n.detail +
        '</p>';
    }

    canvas.addEventListener('mousemove', (e) => {
      const p = rel(e);
      hov = pick(p.x, p.y);
      canvas.style.cursor = hov >= 0 ? 'pointer' : 'crosshair';
    });
    canvas.addEventListener('mouseleave', () => {
      hov = -1;
    });
    canvas.addEventListener('click', (e) => {
      const p = rel(e);
      const i = pick(p.x, p.y);
      if (i >= 0) {
        sel = i;
        show(i);
      }
    });
    canvas.addEventListener(
      'touchstart',
      (e) => {
        const p = rel(e);
        const i = pick(p.x, p.y);
        if (i >= 0) {
          sel = i;
          show(i);
        }
      },
      { passive: true }
    );

    window.addEventListener('resize', resize);
    // Astro View Transitions: stop the loop before the page swaps out.
    document.addEventListener('astro:before-swap', () => cancelAnimationFrame(raf), { once: true });

    resize();
    build();
    if (reduce) {
      // Settle the layout without the perpetual animation.
      for (let i = 0; i < 240; i++) step();
      draw();
    } else {
      loop();
    }
  }

  init();
  document.addEventListener('astro:after-swap', init);
</script>

<style>
  .brain-sub {
    color: var(--dim);
    font-size: 14px;
    margin: 0 0 18px;
    max-width: 52ch;
  }
  .brain-stage {
    border: 1px solid var(--border);
    border-radius: 14px;
    overflow: hidden;
    background: #13100d;
  }
  .brain-legend {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    padding: 11px 15px;
    font-size: 12.5px;
    color: var(--faint);
    border-bottom: 1px solid var(--border);
  }
  .brain-legend span {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  .bd {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    display: inline-block;
  }
  #brainCanvas {
    display: block;
    width: 100%;
    height: 460px;
    cursor: crosshair;
    touch-action: none;
  }
  .brain-detail {
    margin-top: 14px;
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 15px 18px;
    min-height: 70px;
  }
  .brain-detail :global(.bt) {
    font-size: 16px;
    font-weight: 500;
    margin: 0;
    display: flex;
    align-items: center;
    gap: 9px;
  }
  .brain-detail :global(.bty) {
    font-size: 11px;
    color: var(--faint);
    margin: 4px 0 0;
    text-transform: uppercase;
    letter-spacing: 0.12em;
  }
  .brain-detail :global(.bdd) {
    font-size: 14px;
    color: var(--dim);
    margin: 9px 0 0;
    line-height: 1.6;
  }
  .brain-detail .bhint {
    font-size: 14px;
    color: var(--faint);
    margin: 0;
  }
</style>
